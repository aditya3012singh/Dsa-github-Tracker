{
  "title": "📨 Queue Dashboard",
  "uid": "queue-dashboard",
  "refresh": "5s",
  "schemaVersion": 38,
  "version": 1,
  "timezone": "browser",
  "editable": true,
  "tags": [
    "bullmq",
    "queue",
    "observability",
    "coding-analytics"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "queue",
        "type": "query",
        "query": "label_values(coding_analytics_queue_jobs_total, queue)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Active Jobs",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(coding_analytics_queue_active_jobs{queue=~\"$queue\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 2,
      "title": "Jobs / sec",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(coding_analytics_queue_jobs_total{queue=~\"$queue\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3,
      "title": "Retry / sec",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(coding_analytics_queue_retries_total{queue=~\"$queue\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4,
      "title": "Failure Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(coding_analytics_queue_failures_total{queue=~\"$queue\"}[$__rate_interval])) / clamp_min(sum(rate(coding_analytics_queue_jobs_total{queue=~\"$queue\"}[$__rate_interval])), 1) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 5,
      "title": "Queue Processing Time (P50 P95 P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(coding_analytics_queue_duration_seconds_bucket{queue=~\"$queue\"}[$__rate_interval])) by(le)) * 1000",
          "refId": "P50",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(coding_analytics_queue_duration_seconds_bucket{queue=~\"$queue\"}[$__rate_interval])) by(le)) * 1000",
          "refId": "P95",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(coding_analytics_queue_duration_seconds_bucket{queue=~\"$queue\"}[$__rate_interval])) by(le)) * 1000",
          "refId": "P99",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 6,
      "title": "Queue Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by(queue)(rate(coding_analytics_queue_jobs_total{queue=~\"$queue\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 7,
      "title": "Queue Wait Time (P50 P95 P99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(coding_analytics_queue_wait_time_seconds_bucket{queue=~\"$queue\"}[$__rate_interval])) by(le)) * 1000",
          "refId": "P50",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(coding_analytics_queue_wait_time_seconds_bucket{queue=~\"$queue\"}[$__rate_interval])) by(le)) * 1000",
          "refId": "P95",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(coding_analytics_queue_wait_time_seconds_bucket{queue=~\"$queue\"}[$__rate_interval])) by(le)) * 1000",
          "refId": "P99",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 8,
      "title": "Failures by Reason",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "sum by(reason)(rate(coding_analytics_queue_failures_total{queue=~\"$queue\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal" }
    },
    {
      "id": 9,
      "title": "Jobs by Queue",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "sum by(queue)(increase(coding_analytics_queue_jobs_total{queue=~\"$queue\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal" }
    }
  ]
}
