{
  "title": "🗄️ Database Health",
  "uid": "prisma-dashboard",
  "refresh": "5s",
  "schemaVersion": 38,
  "version": 3,
  "timezone": "browser",
  "editable": true,
  "tags": [
    "prisma",
    "postgres",
    "observability",
    "coding-analytics"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "query": "label_values(coding_analytics_prisma_queries_total, model)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "operation",
        "type": "query",
        "query": "label_values(coding_analytics_prisma_queries_total, operation)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Queries / sec",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(coding_analytics_prisma_queries_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 2,
      "title": "Avg Latency",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "(sum(rate(coding_analytics_prisma_query_duration_seconds_sum{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])) / clamp_min(sum(rate(coding_analytics_prisma_query_duration_seconds_count{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])), 1)) * 1000",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3,
      "title": "Slow Queries",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(coding_analytics_prisma_slow_queries_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4,
      "title": "Success Rate",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "100 - (100 * sum(rate(coding_analytics_prisma_errors_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])) / clamp_min(sum(rate(coding_analytics_prisma_queries_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])), 1))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 95 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 5,
      "title": "Query Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum(rate(coding_analytics_prisma_queries_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "Queries/sec"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 12,
      "title": "Throughput by Model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 6 },
      "targets": [
        {
          "expr": "sum by(model)(rate(coding_analytics_prisma_queries_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 13,
      "title": "Throughput by Operation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "targets": [
        {
          "expr": "sum by(operation)(rate(coding_analytics_prisma_queries_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 14,
      "title": "Latency Percentiles",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(coding_analytics_prisma_query_duration_seconds_bucket{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])) by(le)) * 1000",
          "refId": "P50",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(coding_analytics_prisma_query_duration_seconds_bucket{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])) by(le)) * 1000",
          "refId": "P95",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(coding_analytics_prisma_query_duration_seconds_bucket{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])) by(le)) * 1000",
          "refId": "P99",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 6,
      "title": "Query Latency by Model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "(sum by(model)(rate(coding_analytics_prisma_query_duration_seconds_sum{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])) / clamp_min(sum by(model)(rate(coding_analytics_prisma_query_duration_seconds_count{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])), 1)) * 1000",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 7,
      "title": "Query Latency by Operation",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "(sum by(operation)(rate(coding_analytics_prisma_query_duration_seconds_sum{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])) / clamp_min(sum by(operation)(rate(coding_analytics_prisma_query_duration_seconds_count{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])), 1)) * 1000",
          "refId": "A",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 15,
      "title": "Slow Query Trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 30 },
      "targets": [
        {
          "expr": "sum(rate(coding_analytics_prisma_slow_queries_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "Slow Queries"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 8,
      "title": "Top Queried Models",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 30 },
      "targets": [
        {
          "expr": "topk(10, sum by(model)(rate(coding_analytics_prisma_queries_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "options": { "orientation": "horizontal" }
    },
    {
      "id": 9,
      "title": "Slow Queries by Model",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 30 },
      "targets": [
        {
          "expr": "sum by(model)(rate(coding_analytics_prisma_slow_queries_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal" }
    },
    {
      "id": 10,
      "title": "Errors by Operation",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 38 },
      "targets": [
        {
          "expr": "sum by(operation)(rate(coding_analytics_prisma_errors_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{operation}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal" }
    },
    {
      "id": 11,
      "title": "Errors by Model",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 38 },
      "targets": [
        {
          "expr": "sum by(model)(rate(coding_analytics_prisma_errors_total{model=~\"$model\", operation=~\"$operation\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{model}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } },
      "options": { "orientation": "horizontal" }
    },
    {
      "id": 16,
      "title": "PostgreSQL Engine Metrics",
      "type": "row",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 46 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 17,
      "title": "Active Connections",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 47 },
      "targets": [
        {
          "expr": "sum(pg_stat_database_numbackends)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 18,
      "title": "Cache Hit Ratio",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 47 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_hit[$__rate_interval])) / clamp_min(sum(rate(pg_stat_database_blks_hit[$__rate_interval]) + rate(pg_stat_database_blks_read[$__rate_interval])), 1) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 19,
      "title": "Database Deadlocks",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 47 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_deadlocks[$__rate_interval]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "value",
        "graphMode": "area"
      }
    },
    {
      "id": 20,
      "title": "Transactions / sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 53 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_xact_commit[$__rate_interval]))",
          "refId": "commits",
          "legendFormat": "Commits"
        },
        {
          "expr": "sum(rate(pg_stat_database_xact_rollback[$__rate_interval]))",
          "refId": "rollbacks",
          "legendFormat": "Rollbacks"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 21,
      "title": "Database Locks by Mode",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 53 },
      "targets": [
        {
          "expr": "sum by (mode)(pg_locks_count)",
          "refId": "A",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    },
    {
      "id": 22,
      "title": "Disk Reads & Buffer Hits (blocks/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 61 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_database_blks_read[$__rate_interval]))",
          "refId": "reads",
          "legendFormat": "Disk Reads"
        },
        {
          "expr": "sum(rate(pg_stat_database_blks_hit[$__rate_interval]))",
          "refId": "hits",
          "legendFormat": "Buffer Hits"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 23,
      "title": "Checkpoints (Timed vs Requested)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 61 },
      "targets": [
        {
          "expr": "sum(rate(pg_stat_bgwriter_checkpoints_timed[$__rate_interval]))",
          "refId": "timed",
          "legendFormat": "Timed Checkpoints"
        },
        {
          "expr": "sum(rate(pg_stat_bgwriter_checkpoints_req[$__rate_interval]))",
          "refId": "requested",
          "legendFormat": "Requested Checkpoints"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 24,
      "title": "Replication Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 61 },
      "targets": [
        {
          "expr": "pg_replication_lag_seconds",
          "refId": "lag",
          "legendFormat": "Replication Lag"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    }
  ]
}
